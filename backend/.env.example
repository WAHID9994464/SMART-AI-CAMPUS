# NexusEco / Smart AI Campus Backend Environment Variables
# Copy this file to .env and fill in your values
# Keep your real key secret in backend/.env — NEVER commit .env to version control!

# OpenRouter AI Configuration
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-3-flash-preview
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_TIMEOUT_SECONDS=25

# Legacy Gemini AI Configuration (optional fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=20

# Estimated Demonstration Cost Savings (₹)
ESTIMATED_COST_SAVED_INR=20000.0

# Database path (relative to backend directory)
DATABASE_URL=sqlite:///./data/nexuseco.db

# Server settings
HOST=0.0.0.0
PORT=8000

# CORS - frontend origin
FRONTEND_ORIGIN=http://localhost:5173

# Electricity tariff (₹ per kWh)
ELECTRICITY_TARIFF=8.5

# Grid emission factor (kg CO2e per kWh)
GRID_EMISSION_FACTOR=0.82

# Idle delay before auto-shutoff simulation (minutes)
IDLE_DELAY_MINUTES=30

# Upload directory (relative to backend)
UPLOAD_DIR=./uploads
